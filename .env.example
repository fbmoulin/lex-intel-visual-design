# Lex Intel Visual Design - Environment Variables Example
# Desenvolvido por Lex Intelligentia

# =============================================================================
# IMPORTANTE: Nunca commite o arquivo .env real com valores sensíveis!
# Este é apenas um template. Copie para .env e preencha com valores reais.
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# -----------------------------------------------------------------------------
# Supabase Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
# Obtenha em: https://supabase.com/dashboard/project/_/settings/database
# Use a "Connection string" no formato: postgresql://...

# URL de conexão direta do Supabase
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# URL do projeto Supabase (para cliente JS)
SUPABASE_URL=https://[project-ref].supabase.co

# Chave anônima (pública) - segura para usar no cliente
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Chave de serviço (privada) - NUNCA expor no cliente
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -----------------------------------------------------------------------------
# Authentication (OAuth Server)
# -----------------------------------------------------------------------------
OAUTH_SERVER_URL=https://oauth.example.com

# -----------------------------------------------------------------------------
# Session & Security
# -----------------------------------------------------------------------------
# Gere com: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here_minimum_32_characters

# ID do usuário que terá role "admin" automaticamente
OWNER_OPEN_ID=

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
VITE_APP_ID=lex-intel-visual-design

# -----------------------------------------------------------------------------
# External APIs (Optional)
# -----------------------------------------------------------------------------
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# -----------------------------------------------------------------------------
# CORS Configuration (Optional)
# -----------------------------------------------------------------------------
# Domínios permitidos (separados por vírgula)
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# -----------------------------------------------------------------------------
# Rate Limiting (Optional)
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# -----------------------------------------------------------------------------
# File Upload (Optional - se usar Supabase Storage ou S3)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# -----------------------------------------------------------------------------
# Monitoring & Logging (Optional)
# -----------------------------------------------------------------------------
# Server-side Sentry
SENTRY_DSN=your_sentry_dsn_here
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=lex-intel-visual-design@1.2.0-beta

# Client-side Sentry (prefixo VITE_ para expor ao cliente)
VITE_SENTRY_DSN=your_sentry_dsn_here
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_RELEASE=lex-intel-visual-design@1.2.0-beta

LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Feature Flags (Optional)
# -----------------------------------------------------------------------------
ENABLE_REGISTRATION=true
ENABLE_EXPORT_DOCX=true
ENABLE_EXPORT_PDF=true

# -----------------------------------------------------------------------------
# Development Only (não usar em produção)
# -----------------------------------------------------------------------------
# VITE_DEV_SERVER_PORT=5173
# ENABLE_DEBUG=true
